{
  "name": "reference",
  "version": "1.0.0",
  "description": "Model and postprocess reference; engine-specific settings are in hrtc_device_config.json.",
  "algos": [
    {
      "name": "yolov8_detect",
      "config": {
        "preprocess": {
          "device": "auto",
          "interpolation_mode": "linear",
          "resize_type": "letter_box",
          "dst_image_format": "planar_rgb",
          "normalize_type": "full",
          "mean": [0, 0, 0],
          "std": [255, 255, 255],
          "default_color": [114, 114, 114],
          "resize_short_size": -1,
          "pad_scale": 1.0
        },
        "engine": {"backends": [{"engine_type": "ort", "data": "assets/test/onnx/YoloV8Detect.onnx"}]},
        "postprocess": {
          "type": "YoloV8Detect",
          "class_num": 80,
          "confidence_threshold": [0.25],
          "iou_threshold": [0.45]
        }
      }
    },
    {
      "name": "yolo26n_detect_raw",
      "config": {
        "preprocess": {"resize_type": "letter_box", "std": [255, 255, 255], "default_color": [114, 114, 114]},
        "engine": {"backends": [{"engine_type": "ort", "data": "assets/test/onnx/Yolo26Detect.onnx"}]},
        "postprocess": {"type": "Yolo26Detect", "class_num": 80, "confidence_threshold": [0.25], "iou_threshold": [0.45]}
      }
    },
    {
      "name": "yolov5_detect",
      "config": {
        "preprocess": {"resize_type": "letter_box", "std": [255, 255, 255], "default_color": [114, 114, 114]},
        "engine": {"backends": [{"engine_type": "ort", "data": "assets/test/onnx/YoloV5Detect.onnx"}]},
        "postprocess": {
          "type": "YoloV5Detect",
          "class_num": 80,
          "anchors": [[10, 13, 16, 30, 33, 23], [30, 61, 62, 45, 59, 119], [116, 90, 156, 198, 373, 326]],
          "confidence_threshold": [0.25],
          "iou_threshold": [0.45]
        }
      }
    },
    {
      "name": "rtdetr_l_detect",
      "config": {
        "preprocess": {"resize_type": "normal", "std": [255, 255, 255]},
        "engine": {"backends": [{"engine_type": "ort", "data": "assets/test/onnx/DetrDetect.onnx"}]},
        "postprocess": {
          "type": "DetrDetect",
          "class_num": 80,
          "confidence_threshold": [0.25],
          "output_format": "combined",
          "score_activation": "none",
          "background_class": -1
        }
      }
    },
    {
      "name": "yolo26n_e2e_detect",
      "config": {
        "preprocess": {"resize_type": "letter_box", "std": [255, 255, 255], "default_color": [114, 114, 114]},
        "engine": {"backends": [{"engine_type": "ort", "data": "assets/test/onnx/E2EDetect.onnx"}]},
        "postprocess": {"type": "E2EDetect", "class_num": 80, "confidence_threshold": [0.25]}
      }
    },
    {
      "name": "yolov8n_detect",
      "config": {
        "preprocess": {"resize_type": "letter_box", "std": [255, 255, 255], "default_color": [114, 114, 114]},
        "engine": {"backends": [{"engine_type": "ort", "data": "assets/test/onnx/GeneralDetect.onnx"}]},
        "postprocess": {"type": "GeneralDetect", "class_num": 80, "confidence_threshold": [0.25], "iou_threshold": [0.45]}
      }
    },
    {
      "name": "yolo26n_e2e_obb",
      "config": {
        "preprocess": {"resize_type": "letter_box", "std": [255, 255, 255], "default_color": [114, 114, 114]},
        "engine": {"backends": [{"engine_type": "ort", "data": "assets/test/onnx/E2ERotated.onnx"}]},
        "postprocess": {"type": "E2ERotated", "class_num": 15, "confidence_threshold": [0.25]}
      }
    },
    {
      "name": "yolov8n_obb_raw",
      "config": {
        "preprocess": {"resize_type": "letter_box", "std": [255, 255, 255], "default_color": [114, 114, 114]},
        "engine": {"backends": [{"engine_type": "ort", "data": "assets/test/onnx/YoloV8Rotated.onnx"}]},
        "postprocess": {
          "type": "YoloV8Rotated",
          "class_num": 15,
          "confidence_threshold": [0.25],
          "iou_threshold": [0.45]
        }
      }
    },
    {
      "name": "yolo26n_obb_raw",
      "config": {
        "preprocess": {"resize_type": "letter_box", "std": [255, 255, 255], "default_color": [114, 114, 114]},
        "engine": {"backends": [{"engine_type": "ort", "data": "assets/test/onnx/Yolo26Rotated.onnx"}]},
        "postprocess": {"type": "Yolo26Rotated", "class_num": 15, "confidence_threshold": [0.25], "iou_threshold": [0.45]}
