{
  "name": "reference",
  "version": "1.0.0",
  "description": "Every manifest field; see README.md next to this file for allowed values.",
  "algos": [
    {
      "name": "yolov8_detect",
      "config": {
        "preprocess": {
          "device": "auto",
          "interpolation_mode": "linear",
          "resize_type": "letter_box",
          "dst_image_format": "planar_rgb",
          "normalize_type": "full",
          "mean": [0, 0, 0],
          "std": [255, 255, 255],
          "default_color": [114, 114, 114],
          "resize_short_size": -1,
          "pad_scale": 1.0
        },
        "engine": {
          "backends": [
            {
              "engine_type": "trt",
              "config": {"plugin_libraries": [], "input_shapes": {}},
              "data": "models/yolov8_detect.engine"
            },
            {
              "engine_type": "rknn",
              "config": {"image_input": true, "core_mask": "RKNN_NPU_CORE_AUTO", "custom_op_libraries": []},
              "data": "models/yolov8_detect.rknn"
            },
            {
              "engine_type": "cann",
              "data": "models/yolov8_detect.om"
            },
            {
              "engine_type": "mnn",
              "config": {"forward_type": "cpu", "num_thread": 4, "cache_file": "", "cache_dir": ""},
              "data": "models/yolov8_detect.mnn"
            },
            {
              "engine_type": "ncnn",
              "config": {"num_threads": 4},
              "proto": "models/yolov8_detect.param",
              "data": "models/yolov8_detect.bin"
            },
            {
              "engine_type": "ort",
              "config": {
                "intra_op_num_threads": 0,
                "inter_op_num_threads": 0,
                "execution_provider": "cpu",
                "provider_options": {},
                "custom_op_libraries": [],
                "input_shapes": {}
              },
              "data": "models/yolov8_detect.onnx"
            }
          ]
        },
        "postprocess": {
          "type": "YoloV8Detect",
          "class_num": 80,
          "strides": [8, 16, 32],
          "reg_max": 16,
          "confidence_threshold": [0.25],
          "iou_threshold": [0.45]
        }
      }
    },
    {
      "name": "yolov5_detect",
      "config": {
        "preprocess": {"resize_type": "letter_box", "std": [255, 255, 255], "default_color": [114, 114, 114]},
        "engine": {"backends": [{"engine_type": "ort", "data": "models/yolov5_detect.onnx"}]},
        "postprocess": {
          "type": "YoloV5Detect",
          "class_num": 80,
          "strides": [8, 16, 32],
          "anchors": [[10, 13, 16, 30, 33, 23], [30, 61, 62, 45, 59, 119], [116, 90, 156, 198, 373, 326]],
          "confidence_threshold": [0.25],
          "iou_threshold": [0.45]
        }
      }
    },
    {
      "name": "rtdetr_l_detect",
      "config": {
        "preprocess": {"resize_type": "normal", "std": [255, 255, 255]},
        "engine": {"backends": [{"engine_type": "ort", "data": "assets/rtdetr/models/rtdetr-l.onnx"}]},
        "postprocess": {
          "type": "DetrDetect",
          "class_num": 80,
          "confidence_threshold": [0.25],
          "output_format": "combined",
          "score_activation": "none",
          "background_class": -1,
          "boxes_output": 0,
          "scores_output": 1
        }
      }
    },
    {
      "name": "yolo26n_e2e_detect",
      "config": {
        "preprocess": {"resize_type": "letter_box", "std": [255, 255, 255], "default_color": [114, 114, 114]},
        "engine": {"backends": [{"engine_type": "ort", "data": "assets/e2e/models/yolo26n.onnx"}]},
        "postprocess": {"type": "E2eDetect", "class_num": 80, "confidence_threshold": [0.25]}
      }
    },
    {
      "name": "yolov8n_detect",
      "config": {
        "preprocess": {"resize_type": "letter_box", "std": [255, 255, 255], "default_color": [114, 114, 114]},
        "engine": {"backends": [{"engine_type": "ort", "data": "assets/yolo/models/yolov8n.onnx"}]},
        "postprocess": {"type": "GeneralDetect", "class_num": 80, "confidence_threshold": [0.25], "iou_threshold": [0.45]}
      }
    },
    {
      "name": "yolov8_rotated",
      "config": {
        "preprocess": {"resize_type": "letter_box", "std": [255, 255, 255], "default_color": [114, 114, 114]},
        "engine": {"backends": [{"engine_type": "ort", "data": "models/yolov8_rotated.onnx"}]},
        "postprocess": {
          "type": "YoloV8Rotated",
          "class_num": 15,
          "strides": [8, 16, 32],
          "reg_max": 16,
          "confidence_threshold": [0.25],
          "iou_threshold": [0.45]
        }
      }
    },
    {
      "name": "yolov5_rotated",
      "config": {
        "preprocess": {"resize_type": "letter_box", "std": [255, 255, 255], "default_color": [114, 114, 114]},
        "engine": {"backends": [{"engine_type": "ort", "data": "models/yolov5_rotated.onnx"}]},
        "postprocess": {
          "type": "YoloV5Rotated",
          "class_num": 15,
          "strides": [8, 16, 32],
          "anchors": [[10, 13, 16, 30, 33, 23], [30, 61, 62, 45, 59, 119], [116, 90, 156, 198, 373, 326]],
          "confidence_threshold": [0.25],
          "iou_threshold": [0.45]
        }
      }
    },
    {
      "name": "yolov8n_obb",
      "config": {
        "preprocess": {"resize_type": "letter_box", "std": [255, 255, 255], "default_color": [114, 114, 114]},
        "engine": {"backends": [{"engine_type": "ort", "data": "assets/yolo/models/yolov8n-obb.onnx"}]},
        "postprocess": {"type": "GeneralRotated", "class_num": 15, "confidence_threshold": [0.25], "iou_threshold": [0.45]}
      }
    },
    {
      "name": "yolov8n_classify",
      "config": {
        "preprocess": {"std": [255, 255, 255]},
        "engine": {"backends": [{"engine_type": "ort", "data": "assets/yolo/models/yolov8n-cls.onnx"}]},
        "postprocess": {"type": "GeneralClassify", "classify_postprocess_type": "none"}
      }
    },
    {
      "name": "yolov8n_pose",
      "config": {
        "preprocess": {"resize_type": "letter_box", "std": [255, 255, 255], "default_color": [114, 114, 114]},
        "engine": {"backends": [{"engine_type": "ort", "data": "assets/yolo/models/yolov8n-pose.onnx"}]},
        "postprocess": {
          "type": "YoloKeypoint",
          "class_num": 1,
          "keypoint_num": 17,
          "keypoint_threshold": 0.5,
          "confidence_threshold": [0.25],
          "iou_threshold": [0.45]
        }
      }
    },
    {
      "name": "rtmo_s_pose",
      "config": {
        "preprocess": {"resize_type": "keep_ratio", "dst_image_format": "planar_bgr", "default_color": [114, 114, 114]},
        "engine": {"backends": [{"engine_type": "ort", "data": "assets/rtmo/models/rtmo-s_body7_640x640.onnx"}]},
        "postprocess": {"type": "RtmoKeypoint", "confidence_threshold": [0.15], "iou_threshold": [0.65], "keypoint_threshold": 0.3}
      }
    },
    {
      "name": "rtmpose_m_pose",
      "config": {
        "preprocess": {
          "resize_type": "pad_outside",
          "pad_scale": 1.25,
          "mean": [123.675, 116.28, 103.53],
          "std": [58.395, 57.12, 57.375]
        },
        "engine": {
          "backends": [
            {
              "engine_type": "ort",
              "config": {"input_shapes": {"input": [1, 3, 256, 192]}},
              "data": "assets/rtmpose/models/rtmpose-m_simcc-body7_256x192.onnx"
            }
          ]
        },
        "postprocess": {"type": "GeneralKeypoint", "general_keypoint_type": "simcc", "keypoint_threshold": 0.3}
      }
    },
    {
      "name": "general_keypoint",
      "config": {
        "preprocess": {"resize_type": "pad_outside", "pad_scale": 1.25, "mean": [123.675, 116.28, 103.53], "std": [58.395, 57.12, 57.375]},
        "engine": {"backends": [{"engine_type": "ort", "data": "models/general_keypoint.onnx"}]},
        "postprocess": {
          "type": "GeneralKeypoint",
          "general_keypoint_type": "heatmap",
          "heatmap_refine": "dark",
          "score_activation": "none",
          "keypoint_threshold": 0.3
        }
      }
    },
    {
      "name": "yolov8n_segment",
      "config": {
        "preprocess": {"resize_type": "letter_box", "std": [255, 255, 255], "default_color": [114, 114, 114]},
        "engine": {"backends": [{"engine_type": "ort", "data": "assets/yolo/models/yolov8n-seg.onnx"}]},
        "postprocess": {
          "type": "InstanceSegment",
          "class_num": 80,
          "mask_threshold": 0.5,
          "confidence_threshold": [0.25],
          "iou_threshold": [0.45]
        }
      }
    },
    {
      "name": "semantic_segment",
      "config": {
        "preprocess": {"std": [255, 255, 255]},
        "engine": {"backends": [{"engine_type": "ort", "data": "models/semantic_segment.onnx"}]},
        "postprocess": {"type": "SemanticSegment"}
      }
    }
  ]
}
