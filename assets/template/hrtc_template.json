      "config": {
        "preprocess": {"std": [255, 255, 255]},
        "engine": {"backends": [{"engine_type": "ort", "data": "assets/test/onnx/GeneralClassify.onnx"}]},
        "postprocess": {"type": "GeneralClassify", "classify_postprocess_type": "none"}
      }
    },
    {
      "name": "yolov8n_classify_embedding",
      "config": {
        "preprocess": {"std": [255, 255, 255]},
        "engine": {"backends": [{"engine_type": "ort", "data": "assets/test/onnx/Embedding.onnx"}]},
        "postprocess": {"type": "Embedding"}
      }
    },
    {
      "name": "yolov8n_pose",
