{
  "name": "device_config",
  "version": "1.0.0",
  "description": "Engine config examples based on YoloV8Detect; provide converted model files and match preprocessing to the selected backend.",
  "algos": [
    {
      "name": "yolov8_detect",
      "config": {
        "preprocess": {
          "resize_type": "letter_box",
          "std": [
            255,
            255,
            255
          ],
          "default_color": [
            114,
            114,
            114
          ]
        },
        "engine": {
          "backends": [
            {
              "engine_type": "ort",
              "config": {
                "intra_op_num_threads": 1,
                "inter_op_num_threads": 1,
                "execution_provider": "cpu",
                "provider_options": {},
                "custom_op_libraries": [],
                "input_shapes": {}
              },
              "data": "assets/test/onnx/YoloV8Detect.onnx"
            },
            {
              "engine_type": "trt",
              "config": {
                "plugin_libraries": [],
                "input_shapes": {}
              },
              "data": "assets/test/trt/YoloV8Detect.engine"
            },
            {
              "engine_type": "mnn",
              "config": {
                "forward_type": "cpu",
                "num_thread": 4,
                "cache_file": "",
                "cache_dir": ""
              },
              "data": "assets/test/mnn/YoloV8Detect.mnn"
            },
            {
              "engine_type": "ncnn",
              "config": {
                "num_threads": 4
              },
              "proto": "assets/test/ncnn/YoloV8Detect.param",
              "data": "assets/test/ncnn/YoloV8Detect.bin"
            },
            {
              "engine_type": "rknn",
              "config": {
                "image_input": true,
                "core_mask": "RKNN_NPU_CORE_AUTO",
                "custom_op_libraries": []
              },
              "data": "assets/test/rknn/YoloV8Detect.rknn"
            },
            {
              "engine_type": "cann",
              "config": {},
              "data": "assets/test/cann/YoloV8Detect.om"
            }
          ]
        },
        "postprocess": {
          "type": "YoloV8Detect",
          "class_num": 80,
          "confidence_threshold": [
            0.25
          ],
          "iou_threshold": [
            0.45
          ]
        }
      }
    }
  ]
}
